# ArcGIS credentials and endpoints.
# Read by the map-viewer backend and by every script under scripts/ (via
# load_arcgis_env in lib.sh). Anything already exported in your shell wins.
# The credentials never reach the browser: the backend proxies ArcGIS itself.

# ArcGIS portal root — where tokens are minted
ARCGIS_PORTAL_URL=https://edaccit.esrilab.es/portal

# ArcGIS server root — where the FeatureServers live
ARCGIS_SERVER_URL=https://edaccit.esrilab.es/server

# Service account
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# Token lifetime in minutes (default: 120). The portal silently caps this to
# its own maximum. Ingestion asks for a year and takes whatever it is granted:
# the token is baked into every connector instance and nothing refreshes it.
ARCGIS_TOKEN_EXPIRY=120

# Referer the token is bound to (client=referer). The backend sends this same
# value when proxying, so it only needs to be self-consistent.
ARCGIS_REFERER=http://localhost:5173

# Set to "false" if ESRILab uses a self-signed TLS certificate (default: true)
ARCGIS_VERIFY_SSL=true

# Comma-separated allowed CORS origins.
# Only matters for the Vite dev server — the Dockerised viewer serves the SPA
# and its API from the same origin, so it needs no entry here.
ALLOWED_ORIGINS=http://localhost:5173
